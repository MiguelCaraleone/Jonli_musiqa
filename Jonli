@dp.message(StudioStates.waiting_for_demo_voice, F.voice)
async def handle_demo_voice(message: types.Message, state: FSMContext):
    processing_msg = await message.answer("🎧 Ovoz qabul qilindi, 25 sekundlik demo tayyorlanmoqda...")
    
    voice_file = await bot.get_file(message.voice.file_id)
    voice_path = f"voice_{message.from_user.id}.ogg"
    demo_path = f"demo_{message.from_user.id}.mp3"
    
    await bot.download_file(voice_file.file_path, voice_path)
    
    try:
        user_voice = AudioSegment.from_file(voice_path, format="ogg")
        bg_music_path = "background.mp3"
        
        if os.path.exists(bg_music_path):
            background = AudioSegment.from_file(bg_music_path, format="mp3")
            if len(background) > 25000:
                background = background[:25000]
            if len(user_voice) > 25000:
                user_voice = user_voice[:25000]
            background = background - 12
            demo_audio = background.overlay(user_voice)
        else:
            demo_audio = user_voice[:25000]
            
        demo_audio.export(demo_path, format="mp3")
        
        audio_in = FSInputFile(demo_path)
        keyboard = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="💎 To'liq qo'shiqni olish (3.50 daqiqalik)", callback_data="buy_full_song")]
        ])
        
        await message.answer_audio(
            audio=audio_in,
            caption="✨ **Mana sizning 25 sekundlik demo qo'shig'ingiz!**\nTo'liq 3.50 daqiqalik versiyani olish uchun to'lovni amalga oshiring.",
            reply_markup=keyboard,
            parse_mode="Markdown"
        )
        await processing_msg.delete()
    except Exception as e:
        await message.answer(f"Xatolik: {e}")
    finally:
        if os.path.exists(voice_path):
            os.remove(voice_path)
        if os.path.exists(demo_path):
            os.remove(demo_path)

