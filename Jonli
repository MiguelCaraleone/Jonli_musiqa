# 8. Ovoz kelganda uni to'liq 3.50 daqiqalik (230 sekund) qo'shiqqa aylantirish
@dp.message(F.voice)
async def handle_full_song_creation(message: Message):
    processing_msg = await message.answer("🎵 Ovozli yozuv qabul qilindi. Barcha tanlangan cholg'ular bilan **3.50 daqiqalik** to'liq qo'shiq bastalanmoqda...")
    
    voice_file = await bot.get_file(message.voice.file_id)
    voice_path = f"full_voice_{message.from_user.id}.ogg"
    full_output_path = f"full_song_{message.from_user.id}.mp3"
    
    await bot.download_file(voice_file.file_path, voice_path)
    
    try:
        user_voice = AudioSegment.from_file(voice_path, format="ogg")
        bg_music_path = "background.mp3"
        
        # 3.50 daqiqa = 3 * 60 + 50 = 230 sekund = 230 000 millisekund
        target_duration = 230000 
        
        if os.path.exists(bg_music_path):
            background = AudioSegment.from_file(bg_music_path, format="mp3")
            # Fon musiqasini 3.50 daqiqagacha cho'zish (takrorlash)
            if len(background) < target_duration:
                background = background * (target_duration // len(background) + 1)
            background = background[:target_duration]
            
            # Agar foydalanuvchi ovozi 3.50 daqiqadan qisqa bo'lsa, fon davom etadi, ovoz o'z joyida turadi
            background = background - 10
            full_audio = background.overlay(user_voice, position=1000) # 1 sekunddan so'ng boshlanadi
        else:
            full_audio = user_voice[:target_duration]
            
        full_audio.export(full_output_path, format="mp3")
        
        audio_in = FSInputFile(full_output_path)
        await message.answer_audio(
            audio=audio_in,
            caption="🔥 **Mana sizning 3.50 daqiqalik professional to'liq qo'shig'ingiz!**\nMarhamat, tinglang va baho bering.",
            parse_mode="Markdown"
        )
        await processing_msg.delete()
        
    except Exception as e:
        await message.answer(f"Xatolik yuz berdi: {e}")
    finally:
        if os.path.exists(voice_path):
            os.remove(voice_path)
        if os.path.exists(full_output_path):
            os.remove(full_output_path)

